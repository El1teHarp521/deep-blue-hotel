generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bookings {
  id             String   @id @db.Uuid
  user_id        String   @db.Uuid
  room_id        String   @db.Uuid
  check_in       DateTime
  check_out      DateTime
  created_at     DateTime @default(now())
  booking_status String   @default("Confirmed")
  payment_status String   @default("Unpaid")
  guests_count   Int      @default(1)
}

model CleaningRequests {
  id                   String   @id @db.Uuid
  user_id              String   @db.Uuid
  room_id              String   @db.Uuid
  status               String   @default("Pending")
  assigned_employee_id String?  @db.Uuid
  created_at           DateTime @default(now())
  updated_at           DateTime @default(now())
}

model EmployeeSchedules {
  id          String   @id @db.Uuid
  employee_id String   @db.Uuid
  task_type   String
  room_id     String   @db.Uuid
  date        DateTime
  status      String   @default("Scheduled")
  created_at  DateTime @default(now())
}

model LinkedCards {
  id          String   @id @db.Uuid
  user_id     String   @db.Uuid
  last4       String
  token       String
  expire_date String
  created_at  DateTime @default(now())
}

model Transactions {
  id          String   @id @db.Uuid
  user_id     String   @db.Uuid
  amount      Decimal
  type        String
  status      String   @default("Success")
  description String
  created_at  DateTime @default(now())
}

model Users {
  id            String   @id @db.Uuid
  email         String   @unique
  password_hash String
  first_name    String
  last_name     String
  phone         String   @unique
  country       String?
  role          String   @default("User")
  google_linked Boolean  @default(false)
  balance       Decimal  @default(0.0)
  created_at    DateTime @default(now())
  google_email  String?
  google_id     String?  @unique
  is_blocked    Boolean  @default(false)
}

model AdditionalServices {
  id    String  @id @db.Uuid
  name  String  @unique
  price Decimal
}

model Rooms {
  id          String  @id @db.Uuid
  room_number String  @unique
  category    String
  price       Decimal
  status      String  @default("Available")
  description String?
}

model UserServices {
  id             String   @id @db.Uuid
  user_id        String   @db.Uuid
  service_id     String   @db.Uuid
  payment_status String   @default("Paid")
  created_at     DateTime @default(now())
}