generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model bookings {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id     String    @db.Uuid
  room_id     String    @db.Uuid
  check_in    DateTime  @db.Date
  check_out   DateTime  @db.Date
  total_price Decimal   @db.Decimal(10, 2)
  status      String?   @default("Pending") @db.VarChar(50)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  rooms       rooms     @relation(fields: [room_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users       users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model employees {
  id            String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id       String          @db.Uuid
  position      String          @db.VarChar(100)
  users         users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  work_schedule work_schedule[]
}

model rooms {
  id              String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  room_number     String     @unique @db.VarChar(20)
  type            String     @db.VarChar(100)
  capacity        Int
  size_sqm        Decimal    @db.Decimal(5, 2)
  price_per_night Decimal    @db.Decimal(10, 2)
  is_active       Boolean?   @default(true)
  bookings        bookings[]
}

model users {
  id            String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email         String      @unique @db.VarChar(255)
  password_hash String      @db.VarChar(255)
  full_name     String      @db.VarChar(255)
  role          String?     @default("User") @db.VarChar(50)
  created_at    DateTime?   @default(now()) @db.Timestamp(6)
  bookings      bookings[]
  employees     employees[]
}

model work_schedule {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  employee_id String    @db.Uuid
  shift_date  DateTime  @db.Date
  start_time  DateTime  @db.Time(6)
  end_time    DateTime  @db.Time(6)
  status      String?   @default("Scheduled") @db.VarChar(50)
  employees   employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
