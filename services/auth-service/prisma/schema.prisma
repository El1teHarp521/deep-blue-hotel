generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  password_hash String
  full_name     String
  role          String   @default("User")
  created_at    DateTime @default(now())
}