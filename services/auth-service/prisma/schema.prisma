generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  password_hash String
  first_name    String
  last_name     String
  phone         String   @unique
  country       String?
  role          String   @default("User") // User, Guest, Employee, Admin
  google_linked Boolean  @default(false)
  google_id     String?  @unique
  google_email  String?  
  balance       Decimal  @default(0.0)
  is_blocked    Boolean  @default(false)
  created_at    DateTime @default(now())
}

model LinkedCards {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  last4       String   
  token       String   
  expire_date String   
  created_at  DateTime @default(now())
}

model Transactions {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  amount      Decimal
  type        String   // REFILL, BOOKING, SERVICE, REFUND, DEBT_PAY
  status      String   @default("Success")
  description String
  created_at  DateTime @default(now())
}

model Rooms {
  id            String   @id @default(uuid()) @db.Uuid
  room_number   String   @unique
  category      String   
  price         Decimal  
  status        String   @default("Available") 
  description   String?
}

model Bookings {
  id             String   @id @default(uuid()) @db.Uuid
  user_id        String   @db.Uuid
  room_id        String   @db.Uuid
  check_in       DateTime
  check_out      DateTime
  payment_status String   @default("Unpaid") // Paid, Unpaid
  booking_status String   @default("Confirmed")
  created_at     DateTime @default(now())
  guests_count   Int      @default(1)
}

model AdditionalServices {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique
  price      Decimal  
}

model UserServices {
  id             String   @id @default(uuid()) @db.Uuid
  user_id        String   @db.Uuid
  service_id     String   @db.Uuid
  quantity       Int      @default(1)
  payment_status String   @default("Paid")
  created_at     DateTime @default(now())
}

// ТАБЛИЦА: РЕАЛЬНЫЕ ЗАПИСИ НА МАССАЖ (ТЗ)
model MassageBookings {
  id             String   @id @default(uuid()) @db.Uuid
  user_id        String   @db.Uuid
  specialist_id  Int      // ID мастера: 1, 2, 3
  date           String   // Формат YYYY-MM-DD
  time           String   // Формат HH:MM
  status         String   @default("Confirmed")
  created_at     DateTime @default(now())
}

model CleaningRequests {
  id                    String   @id @default(uuid()) @db.Uuid
  user_id               String   @db.Uuid
  room_id               String   @db.Uuid
  status                String   @default("Pending") 
  assigned_employee_id  String?  @db.Uuid
  created_at            DateTime @default(now())
  updated_at            DateTime @default(now()) @updatedAt
}

model EmployeeSchedules {
  id                    String   @id @default(uuid()) @db.Uuid
  employee_id           String   @db.Uuid
  task_type             String   
  room_id               String   @db.Uuid
  date                  DateTime
  status                String   @default("Scheduled") 
  created_at            DateTime @default(now())
}